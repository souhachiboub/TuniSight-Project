				<!-- JavaScript pour charger le formulaire et gérer la soumission -->
				<script>
					document.addEventListener('DOMContentLoaded', function () { // Charger le formulaire dans le modal lorsqu'il est ouvert
document.getElementById('voucherModal').addEventListener('show.bs.modal', function (event) {
const activityId = {{ activite.id|json_encode }};
fetch(`/load-voucher-form/${activityId}`).then(response => response.text()).then(data => {
document.getElementById('voucherFormContainer').innerHTML = data;
}).catch(error => console.error('Erreur lors du chargement du formulaire', error));
});

document.addEventListener('submit', function (event) {
if (event.target.id === 'voucherForm') {
event.preventDefault();
const formData = new FormData(event.target);
const activityId = {{ activite.id|json_encode }};

fetch(`/apply-voucher/${activityId}`, {
method: 'POST',
body: formData
}).then(response => {
if (!response.ok) {
return response.json().then(data => {
throw new Error(data.message); // Utiliser le message de l'API pour l'afficher
});
}
return response.json();
}).then(data => {
if (data.status === 'success') {
alert(data.message); // Afficher un message de succès
window.location.reload(); // Recharger la page pour afficher le nouveau prix
} else {
alert(data.message); // Afficher un message d'erreur
}
}).catch(error => {
console.error('Erreur lors de la soumission du formulaire', error);
alert('Une erreur est survenue : ' + error.message); // Afficher un message d'erreur général
});
}
});
});
