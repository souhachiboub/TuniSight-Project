	<body>
		<!-- code du calcul prix total - et + - lezm ykoun f awl lbody, bch l page ta9ra les fonctions increment & decrement */-->

		<script>
			let nbrPersonnes = 1;
const prixUnitaire = {{ activite.prix }};
const capaciteMax = {{ activite.capacite }};

function updateTotalPrice() {
const totalPrice = nbrPersonnes * prixUnitaire;
document.getElementById('totalPrice').textContent = totalPrice + ' DT';
document.getElementById('totalPriceInput').value = totalPrice; // Met à jour le champ caché
document.getElementById('nbrPersonnesInput').value = nbrPersonnes; // Met à jour le champ caché
}
function updateButtons() {
document.querySelector('.counter button:first-child').disabled = nbrPersonnes === 1;
document.querySelector('.counter button:last-child').disabled = nbrPersonnes === capaciteMax;
}

function increment() {
if (nbrPersonnes < capaciteMax) {
nbrPersonnes++;
document.getElementById('nbrPersonnes').textContent = nbrPersonnes;
updateTotalPrice();
updateButtons();
}
}

function decrement() {
if (nbrPersonnes > 1) {
nbrPersonnes--;
document.getElementById('nbrPersonnes').textContent = nbrPersonnes;
updateTotalPrice();
updateButtons();
}
}

document.addEventListener('DOMContentLoaded', function () {
updateTotalPrice();
updateButtons();
});
		</script>


