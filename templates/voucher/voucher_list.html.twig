{% block body %}
{% for voucher in vouchers %}
    <div class="col-md-4">
        <div class="card shadow-sm mb-4 rounded">
            <div class="card-body">
                <h5 class="card-title {% if not voucher.user %}blur-text{% endif %}">
                    {{ voucher.codeVoucher }}
                </h5>
                <p class="card-text">
                    <strong>Valeur :</strong> {{ voucher.valeurReduction }}% <br>
                    <strong>Date d'Expiration :</strong> 
                    <span class="{% if voucher.dateExpiration < "now"|date %}text-danger{% else %}text-success{% endif %}">
                        {{ voucher.dateExpiration|date('d/m/Y') }}
                    </span> 
                    <br>
                    <strong>Assigné à :</strong> 
                    {% if voucher.user %}
                        <span class="text-primary">{{ voucher.user.email }}</span>
                    {% else %}
                        <span class="text-muted">Non assigné</span>
                    {% endif %}
                </p>
                <div class="mt-3 d-flex justify-content-between">
                    <a href="{{ path('voucher_edit', {id: voucher.id}) }}" class="btn btn-primary btn-sm">
                        <i class="fas fa-edit"></i> Modifier
                    </a>
                    <form method="post" action="{{ path('voucher_delete', {'id': voucher.id}) }}" 
                          onsubmit="return confirm('Voulez-vous vraiment supprimer ce voucher ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ voucher.id) }}">
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="fas fa-trash"></i> Supprimer
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% else %}
    <div class="col-12 text-center">
        <p class="text-muted">Aucun voucher disponible.</p>
    </div>
{% endfor %}

<style>
    .blur-text {
        filter: blur(5px);
        user-select: none; 
        pointer-events: none; 
    }

    .btn {
        transition: all 0.3s ease-in-out;
        border-radius: 8px;
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
        color: white;
    }

    .btn-primary:hover {
        background-color: #0056b3;
        border-color: #004085;
    }

    .btn-outline-danger {
        color: #dc3545;
        border-color: #dc3545;
        background-color: transparent;
    }

    .btn-outline-danger:hover {
        background-color: #dc3545;
        color: white;
    }

    .card {
        border-radius: 12px;
        box-shadow: 0px 4px 10px rgba(187, 186, 186, 0.01);
    }

    /* Ajoutez ces styles pour adoucir les polices */
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #4a4a4a; /* Une nuance de gris plus claire */
    }

    .card-title {
        font-weight: 600; /* Un peu plus léger que le bold */
        color: #333; /* Une nuance de gris légèrement plus foncée */
    }

    .card-text {
        font-weight: 400; /* Poids normal pour le texte */
        color: #666; /* Une nuance de gris plus claire */
    }

    .text-primary {
        color: #007bff !important; /* Couleur primaire plus douce */
    }

    .text-muted {
        color: #999 !important; /* Une nuance de gris plus claire pour le texte muet */
    }

    .text-danger {
        color: #dc3545 !important; /* Rouge moins vif */
    }

    .text-success {
        color: #28a745 !important; /* Vert moins vif */
    }
</style>
{% endblock %}