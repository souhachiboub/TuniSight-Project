{% extends 'offre/templateadmin.html.twig' %}

{% block body %}
<div class="container-fluid">
    <h1>Modifier Ce Voucher</h1>

    {# Display any error flash messages #}
    {% for flash in app.flashes('error') %}
        <div class="alert alert-danger">{{ flash }}</div>
    {% endfor %}

    {# Form start with no validation attribute #}
    {{ form_start(voucherForm, {'attr': {'novalidate': 'novalidate'}}) }}
    
    {# Display specific errors for dateExpiration and valeurReduction #}
    <div class="mb-3">
        {{ form_label(voucherForm.dateExpiration) }}
        {{ form_widget(voucherForm.dateExpiration, {'attr': {'class': 'form-control' ~ (voucherForm.dateExpiration.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
        {{ form_errors(voucherForm.dateExpiration) }}
    </div>
    
    <div class="mb-3">
        {{ form_label(voucherForm.valeurReduction) }}
        {{ form_widget(voucherForm.valeurReduction, {'attr': {'class': 'form-control' ~ (voucherForm.valeurReduction.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
        {{ form_errors(voucherForm.valeurReduction) }}
    </div>

    {# Conditional rendering for the user field if it's defined #}
    {% if voucherForm.user is defined %}
        <div class="mb-3">
            {{ form_label(voucherForm.user) }}
            {{ form_widget(voucherForm.user, {'attr': {'class': 'form-control' ~ (voucherForm.user.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
            {{ form_errors(voucherForm.user) }}
        </div>
    {% endif %}

    {# Submit button #}
    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Modifier</button>
    </div>

    {# End form #}
    {{ form_end(voucherForm) }}
</div>
{% endblock %}
