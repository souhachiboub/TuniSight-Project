{% extends 'baseboutique.html.twig' %}

{% block mescommandes %}
    <h2>📦 Mes Commandes</h2>

    {% if commandes is empty %}
        <div class="alert alert-warning">Aucune commande passée.</div>
    {% else %}
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Date</th>
                    <th>Total (€)</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody>
                {% for commande in commandes %}
                    <tr>
                        <td>#{{ commande.id }}</td>
                        <td>{{ commande.dateCreation|date('d/m/Y') }}</td>
                        <td>{{ commande.prixtotale|number_format(2, ',', ' ') }}€</td>
                        <td>
                            {% if commande.status == 'En cours' %}
                                <span class="badge bg-warning">🕒 En cours</span>
                            {% elseif commande.status == 'Expédiée' %}
                                <span class="badge bg-primary">📦 Expédiée</span>
                            {% elseif commande.status == 'Livrée' %}
                                <span class="badge bg-success">✅ Livrée</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}


