{% extends 'squeletteboutique.html.twig' %}

{% block title %}Gestion des Commandes{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1>📦 Commandes Payées</h1>

    {% if commandes is empty %}
        <div class="alert alert-warning text-center">
            Aucune commande enregistrée.
        </div>
    {% else %}
        <table class="table table-striped">
            <thead>
                <tr>
                    <th><input type="checkbox" id="selectAll"></th>
                    <th>ID</th>
                    <th>Client</th>
                    <th>Date</th>
                    <th>Total (€)</th>
                    <th>Téléphone</th>
                                        <th>Status</th>

                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for commande in commandes %}
                    <tr>
                        <td><input type="checkbox" class="commande-checkbox" value="{{ commande.id }}"></td>
                        <td>#{{ commande.id }}</td>
                        <td>{{ commande.nom }} {{ commande.prenom }}</td>
                        <td>{{ commande.dateCreation|date('d/m/Y') }}</td>
                        <td><strong>{{ commande.prixtotale|number_format(2, ',', ' ') }} €</strong></td>
                        <td>{{ commande.numerotelephone }}</td>
                        <td>
                            <select class="form-select status-change" data-id="{{ commande.id }}">
                                <option value="En cours" {{ commande.status == 'En cours' ? 'selected' }} >En cours</option>
                                <option value="Expédiée" {{ commande.status == 'Expédiée' ? 'selected' }}>Expédiée</option>
                                <option value="Livrée" {{ commande.status == 'Livrée' ? 'selected' }}>Livrée</option>
                            </select>
                        </td>

                        <td>
                            <button class="btn btn-primary btn-sm voir-details" data-id="{{ commande.id }}">
                                👁️ Voir
                            </button>
                            <button class="btn btn-danger btn-sm delete-commande" data-id="{{ commande.id }}">
                                🗑️ Supprimer
                            </button>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <button id="deleteSelectedBtn" class="btn btn-danger mt-3" style="display: none;">
            🗑️ Supprimer la sélection
        </button>
    {% endif %}
</div>

<!-- Modal Détails -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Détails de la Commande</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Produit</th>
                            <th>Référence</th>
                            <th>Quantité</th>
                            <th>Prix (€)</th>
                        </tr>
                    </thead>
                    <tbody id="detailsTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Confirmation -->
<div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Voulez-vous vraiment supprimer cette commande ?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">Oui, supprimer</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Succès -->
<div class="modal fade" id="successModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-success">✔ Suppression réussie</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                La commande a été supprimée avec succès.
            </div>
        </div>
    </div>
</div>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        let selectedCommandes = [];
        let commandeIdToDelete = null;

        // Voir détails d'une commande
        document.querySelectorAll(".voir-details").forEach(button => {
            button.addEventListener("click", async function () {
                let id = this.dataset.id;
                try {
                    let response = await fetch(`/admin/commandes/details/${id}`);
                    if (!response.ok) throw new Error("Erreur serveur");
                    
                    let data = await response.json();
                    let tableBody = document.getElementById("detailsTableBody");
                    tableBody.innerHTML = "";

                    data.details.forEach(detail => {
                        let row = `<tr>
                            <td>${detail.produit}</td>
                            <td>${detail.reference}</td>
                            <td>${detail.quantite}</td>
                            <td>${detail.prix}€</td>
                        </tr>`;
                        tableBody.innerHTML += row;
                    });

                    new bootstrap.Modal(document.getElementById("detailsModal")).show();
                } catch (error) {
                    alert("Erreur lors de la récupération des détails !");
                    console.error(error);
                }
            });
        });

        // Suppression d'une commande
        document.querySelectorAll(".delete-commande").forEach(button => {
            button.addEventListener("click", function () {
                commandeIdToDelete = this.dataset.id;
                new bootstrap.Modal(document.getElementById("confirmModal")).show();
            });
        });

        document.getElementById("confirmDelete").addEventListener("click", async function () {
            try {
                let response = await fetch(`/admin/commande/delete/${commandeIdToDelete}`, { 
                    method: "DELETE", 
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });

                if (!response.ok) throw new Error("Échec de la suppression");

                new bootstrap.Modal(document.getElementById("successModal")).show();

                setTimeout(() => location.reload(), 1500);
            } catch (error) {
                alert("Erreur lors de la suppression !");
                console.error(error);
            }
        });











document.querySelectorAll(".status-change").forEach(select => {
    select.addEventListener("change", async function () {
        // Récupérer l'ID et le statut
        let id = this.dataset.id;
        let status = this.value;

        // Vérifier que l'ID et le statut sont définis
        if (!id || !status) {
            console.error("ID ou statut manquant");
            return;
        }

        try {
            // Envoyer la requête au serveur
            let response = await fetch(`/admin/commande/status/${id}`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                },
                body: JSON.stringify({ status })
            });

            // Vérifier si la réponse est OK
            if (!response.ok) {
                throw new Error(`Erreur HTTP ! Statut : ${response.status}`);
            }

            // Traiter la réponse JSON
            let data = await response.json();
            console.log("Statut mis à jour avec succès :", data);

            // Feedback visuel à l'utilisateur (optionnel)
            toastr.success("Statut mis à jour avec succès !");

            // Mettre à jour le DOM (optionnel)
            // Exemple : Mettre à jour le texte du statut dans la ligne du tableau
            let statusCell = this.closest("tr").querySelector(".status-text");
            if (statusCell) {
                statusCell.innerText = status;
            }
        } catch (error) {
            // Gestion des erreurs
            console.error("Erreur lors de la mise à jour du statut :", error);
            toastr.error("Erreur lors de la mise à jour du statut !");
        }
    });
});
















        // Sélection multiple
        document.getElementById("selectAll").addEventListener("change", function () {
            let checkboxes = document.querySelectorAll(".commande-checkbox");
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
            toggleDeleteSelectedBtn();
        });

        document.querySelectorAll(".commande-checkbox").forEach(checkbox => {
            checkbox.addEventListener("change", toggleDeleteSelectedBtn);
        });

        function toggleDeleteSelectedBtn() {
            selectedCommandes = Array.from(document.querySelectorAll(".commande-checkbox:checked"))
                .map(checkbox => checkbox.value);
            document.getElementById("deleteSelectedBtn").style.display = selectedCommandes.length > 0 ? "block" : "none";
        }

        // Suppression multiple
        document.getElementById("deleteSelectedBtn").addEventListener("click", async function () {
            try {
                await Promise.all(selectedCommandes.map(id => 
                    fetch(`/admin/commande/delete/${id}`, { 
                        method: "DELETE", 
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    })
                ));

                new bootstrap.Modal(document.getElementById("successModal")).show();

                setTimeout(() => location.reload(), 1500);
            } catch (error) {
                alert("Erreur lors de la suppression multiple !");
                console.error(error);
            }
        });










      












    });
</script>



<script>
    document.addEventListener("DOMContentLoaded", function () {
        function checkNewOrders() {
            fetch('/admin/commandes/check-new')
                .then(response => response.json())
                .then(data => {
                    if (data.new) {
                        toastr.success(
                            `Nouvelle commande #${data.commande_id} de ${data.client} - Total: ${data.total}`,
                            "📢 Nouvelle Commande"
                        );
                    }
                })
                .catch(error => console.error("Erreur AJAX :", error));
        }

        // Vérifier toutes les 5 secondes s'il y a une nouvelle commande
        setInterval(checkNewOrders, 5000);
    });
</script>



{% endblock %}


