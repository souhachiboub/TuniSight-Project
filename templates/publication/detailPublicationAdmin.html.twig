{% block js %}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Get the carousel element inside the modal
        const modal = document.getElementById('imageModal');
        const carousel = modal.querySelector('.carousel');
        const carouselImagesContainer = carousel.querySelector('.carousel-images');
        const totalImages = carouselImagesContainer.children.length;
        // Set a shared index variable (could also be stored as a data attribute)
        let currentIndex = 0;
    
        // Function to update the carousel transform
        function updateCarousel() {
            carouselImagesContainer.style.transform = `translateX(-${currentIndex * 100}%)`;
        }
    
        // Next and Previous button event listeners
        const prevButton = carousel.querySelector(".carousel-prev");
        const nextButton = carousel.querySelector(".carousel-next");
    
        if (prevButton && nextButton) {
            nextButton.addEventListener("click", () => {
                currentIndex = (currentIndex + 1) % totalImages;
                updateCarousel();
            });
    
            prevButton.addEventListener("click", () => {
                currentIndex = (currentIndex - 1 + totalImages) % totalImages;
                updateCarousel();
            });
        }
    
        // Image Grid Click Handler:
        // When an image is clicked, open the modal and update the carousel position.
        document.querySelectorAll(".image-grid").forEach(grid => {
            grid.addEventListener('click', function (event) {
                if (event.target.tagName === 'IMG') {
                    document.body.style.overflow = 'hidden';
                    modal.style.display = 'block';
    
                    // Retrieve the clicked image index from its data attribute
                    currentIndex = parseInt(event.target.dataset.imageIndex);
                    updateCarousel();
                }
            });
        });
    
        // Close Modal Handlers
        const closeButton = modal.querySelector('.close-modal');
        function closeModal() {
            document.body.style.overflow = ''; // Restore body scroll
            modal.style.display = 'none';
        }
        closeButton.addEventListener('click', closeModal);
        window.addEventListener('click', (event) => {
            if (event.target === modal) {
                closeModal();
            }
        });
        const requiredFields = document.querySelectorAll('input[required], textarea[required]');


    });
    
</script>
