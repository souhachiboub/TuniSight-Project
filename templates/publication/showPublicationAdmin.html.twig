{% extends "admin/templateadmin.html.twig" %}


{% block body %}



<!-- Begin Page Content -->
<div class="container-fluid">
    <form method="GET" action="{{ path('admin_list_publications') }}" class="d-none d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100 navbar-search">
        <div class="input-group" >
            <input value="{{ searchQuery }}" name="searchQuery" type="text" class="form-control bg-light border-0 small" placeholder="Chercher..."
                aria-label="Search" aria-describedby="basic-addon2" >
            <div class="input-group-append">
                <button class="btn btn-primary" type="submit">
                    <i class="fas fa-search fa-sm"></i>
                </button>
            </div>
        </div>
    </form>
    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h4 class="m-0 font-weight-bold text-primary">Liste des publications</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Utilisateur</th>
                            <th>Contenu</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="publicationTableBody">
                    {% for publication in publications %}
                        <tr class="publication-card" data-id="{{ publication.id }}">
                            <td>{{ publication.user.nom }} {{ publication.user.prenom }}</td>
                            <td>
                                {% if publication.contenu|length > 60 %} 
                                    {{ publication.contenu|slice(0, 60) }} ...
                                {% else %}
                                    {{ publication.contenu }}
                                {% endif %}
                            </td>
                            <td>{{ publication.datePublication|date('Y-m-d') }}</td>
                            <td>
                                <a href="{{ path('detail_publications_admin', {'id': publication.id})}}" class="btn btn-info">Voir</a>
                                <a href="#" class="btn btn-danger delete-link" data-id="{{ publication.id }}">Supprimer</a>
                            </td>
                        </tr>
                    {% else %}
                        <p>Aucune publication trouvée.</p>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <!-- Pagination -->
            <div class="d-flex justify-content-center">
                {{ knp_pagination_render(publications, null, {'size': 'pagination-lg'}) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block css %}
<style>
    .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10px 0;
    gap: 5px;
}

.pagination li {
    list-style: none;
}

.pagination a,
.pagination span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease-in-out;
    border: 1px solid #ddd;
    background-color: #fff;
    color: #007bff;
    border-radius: 6px; /* Coins arrondis pour un look plus moderne */
}

.pagination .active span {
    background-color: #007bff;
    color: white;
    font-weight: bold;
    border-color: #007bff;
}

.pagination a:hover {
    background-color: #e9ecef;
    color: #0056b3;
}

.pagination .disabled span {
    background-color: #f8f9fa;
    color: #6c757d;
    cursor: not-allowed;
    border-color: #ddd;
}

/* Style des flèches (si on veut une seule icône au lieu de "Previous" / "Next") */
.pagination .prev-next {
    font-size: 16px;
    font-weight: bold;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f8f9fa;
    border: 1px solid #ddd;
    color: #007bff;
    cursor: pointer;
    border-radius: 6px;
}

.pagination .prev-next:hover {
    background-color: #e9ecef;
    color: #0056b3;
}
.pagination .active span {
    background-color: #007bff !important;
    color: white !important;
    font-weight: bold;
    border-color: #007bff !important;
    box-shadow: 0 0 5px rgba(0, 123, 255, 0.5); /* Ajoute une légère lueur pour effet moderne */
}

</style>
{% endblock %}

{% block js %}
<script>
    document.querySelectorAll('.delete-link').forEach(link => {
        link.addEventListener('click', (event) => {
            event.preventDefault();
            const publicationId = link.dataset.id;
            
            fetch(`/publication/delete/${publicationId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const publicationElement = document.querySelector(`.publication-card[data-id="${publicationId}"]`);
                    if (publicationElement) {
                        publicationElement.remove();
                    }
                    paginate();
                } else {
                    alert('Erreur lors de la suppression : ' + data.message);
                }
            })
            .catch(error => console.error('Erreur:', error));
        });
    });

    let currentPage = 1;
    const rowsPerPage = 10;
    const tableBody = document.getElementById('publicationTableBody');
    const rows = Array.from(tableBody.getElementsByTagName('tr'));
    const totalPages = Math.ceil(rows.length / rowsPerPage);
    
    function paginate() {
        rows.forEach((row, index) => {
            row.style.display = (index >= (currentPage - 1) * rowsPerPage && index < currentPage * rowsPerPage) ? '' : 'none';
        });
        document.getElementById('pageNumber').innerText = currentPage;
    }
    
    document.getElementById('prevPage').addEventListener('click', () => {
        if (currentPage > 1) {
            currentPage--;
            paginate();
        }
    });
    
    document.getElementById('nextPage').addEventListener('click', () => {
        if (currentPage < totalPages) {
            currentPage++;
            paginate();
        }
    });
    
    paginate();
</script>
{% endblock %}