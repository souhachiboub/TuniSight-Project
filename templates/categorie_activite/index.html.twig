				class="sidebar-divider">

				<!-- Nav Item - Charts -->
				<li class="nav-item">
					<a class="nav-link" href="{{asset('activite')}}">
						<i class="fas fa-fw fa-chart-area"></i>
						<span style="font-size:16px">Activités</span>
					</a>
				</li>

				<!-- Divider -->
				<hr class="sidebar-divider d-none d-md-block">
				<li class="nav-item">
