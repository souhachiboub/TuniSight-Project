{# templates/security/login.html.twig #}

{# {% extends 'base.html.twig' %} #}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h2 class="text-center">Connexion</h2>

        {% if error %}
            <div class="alert alert-danger">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post">
            <div class="mb-3">
                <label for="inputEmail" class="form-label">Email</label>
                <input type="email" name="email" id="inputEmail" class="form-control" value="{{ last_username }}" required autofocus>
            </div>

            <div class="mb-3">
                <label for="inputPassword" class="form-label">Mot de passe</label>
                <input type="password" name="password" id="inputPassword" class="form-control" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn btn-primary w-100">Se connecter</button>
        </form>

        <div class="mt-3 text-center">
            <a href="{{ path('app_register') }}">Créer un compte</a> | 
          
        </div>
    </div>
{% endblock %}
{% block title %}Login{% endblock %}

{% block content %}
    <header>Login</header>
    
    {{ form_start(form) }}
    
    <div class="field input-field">
        {{ form_widget(form.email, { 'attr': {'class': 'input', 'placeholder': 'Email'} }) }}
    </div>

    <div class="field input-field">
        {{ form_widget(form.motdepasse, { 'attr': {'class': 'password', 'placeholder': 'Password', 'type': 'password'} }) }}
        <i class='bx bx-hide eye-icon'></i>
    </div>

    <div class="form-link">
        <a href="#" class="forgot-pass">Forgot password?</a>
    </div>

    <div class="field button-field">
        <button type="submit">Login</button>
    </div>

    {{ form_end(form) }}

    <br><br><br><br><br><br>
    <center>
        <a href="{{ path('app_inscription_front') }}" style="color: black;">
            Vous n'avez pas un compte ?
        </a>
    </center>
{% endblock %}
