{% extends 'baseboutique.html.twig' %}

{% block listActivites %}
    <section class="ftco-section">
        <div class="container">
            <div class="row justify-content-center pb-4">
                <div class="col-md-12 heading-section text-center ftco-animate">
                    <span class="subheading">Boutique</span>
                    <h2 class="mb-4">Nos produits</h2>
                </div>
                {# ✅ Bouton "Mes commandes" visible uniquement si l'utilisateur est connecté et a des commandes #}
            </div>
           <!-- Formulaire de recherche et de filtrage -->
<form method="get" action="{{ path('app_boutique') }}" class="mb-3" id="filterForm">
    <table style="width: 100%; border-collapse: separate; border-spacing: 15px;">
        <tr>
            <!-- Barre de recherche -->
            <td style="width: 33%;">
                <input type="text" class="form-control" name="search" id="search" 
                       placeholder="Rechercher un produit" value="{{ app.request.query.get('search') }}" 
                       style="width: 100%; min-height: 45px;">
            </td>
            <!-- Sélecteur de catégorie -->
            <td style="width: 33%;">
                <select name="category" class="form-select" id="category" 
                        style="width: 100%; min-height: 45px;">
                    <option value="">Toutes les catégories</option>
                    {% for categorie in categories %}
                        <option value="{{ categorie.id }}" {% if app.request.query.get('category') == categorie.id %}selected{% endif %}>
                            {{ categorie.nom }}
                        </option>
                    {% endfor %}
                </select>
            </td>
            <!-- Zone pour le slider de prix -->
            <td style="width: 33%;">
                <div id="price-slider" style="border: 1px solid #ccc; border-radius: 5px; height: 45px; 
                     display: flex; align-items: center; justify-content: center;">
                    <!-- Le slider sera ici -->
                </div>
            </td>
        </tr>
    </table>
    <!-- Champs cachés pour transmettre les valeurs sélectionnées -->
    <input type="hidden" name="minPrice" id="minPrice" value="{{ app.request.query.get('minPrice')|default(0) }}">
    <input type="hidden" name="maxPrice" id="maxPrice" value="{{ app.request.query.get('maxPrice')|default(1000) }}">
</form>



            <!-- Affichage des produits -->
           <div class="row" id="product-list">
    {% for produit in products %}
        <div class="col-md-4 ftco-animate product-item"
             data-category="{{ produit.CategorieProduit.id }}"
             data-price="{{ produit.prix }}"
             data-search="{{ produit.libelle|lower }} {{ produit.description|lower }}">
            <div class="project-wrap">
                <a href="#" class="img" style="background-image: url('{{ asset('uploads/produits/' ~ produit.image) }}');">
                    <span class="price"> {{ produit.prix }} TN</span>
                </a>
                
                <div class="text p-4">
                    <h3 class="text-start">{{ produit.libelle }}</h3>
                    
                    <div class="d-flex align-items-center justify-content-between mt-3">
                        <button class="btn-simple" 
                                onclick="addToCart({{ produit.id }}, '{{ produit.libelle }}', {{ produit.prix }})"
                                {% if not produit.isDisponible %} disabled {% endif %}>
                            Ajouter au panier
                        </button>

                        <button class="btn-simple btn-detail text-center" 
                                onclick="window.location.href='{{ path('afficherproduit', {'id': produit.id}) }}'">
                            <span class="d-block w-100">Détail</span>
                        </button>
                    </div>

                    <!-- Indicateur de disponibilité amélioré -->
                    <div class="mt-3 text-center">
                        <span class="badge d-inline-flex align-items-center px-3 py-2 fs-6 text-white"
                              style="background-color: {% if produit.isDisponible %}#198754{% else %}#dc3545{% endif %}; 
                                     min-width: 80px; gap: 5px;">
                            {% if produit.isDisponible %}
                                <i class="fas fa-check-circle"></i> En stock
                            {% else %}
                                <i class="fas fa-times-circle"></i> Rupture
                            {% endif %}
                        </span>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
 

</div>

        <!-- Icône Chariot -->
    <div class="cart-container" onclick="toggleCart()">
        <i class="fas fa-shopping-cart"></i>
<span id="cartCount" class="badge" style="background-color: #f7faff; color: white;">0</span>    </div>
    <!-- Panier déroulant -->
    <div class="cart-dropdown" id="cartDropdown">
        <h4>Mon Panier</h4>
        <div id="cartItems"></div>
        <div id="cartTotal"></div>

        <button class="btn " onclick="clearCart()">Vider le panier</button>
        <button onclick="checkout()">Passer à la caisse</button>

    </div>
{% endblock %}
{% block javascripts112 %}
<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<!-- Bootstrap CSS -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    let mesCommandesBtn = document.getElementById("mesCommandesBtn");
    if (mesCommandesBtn) {
        mesCommandesBtn.addEventListener("click", function () {
            fetch("{{ path('mes_commandes') }}", {
                method: "GET",
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error("Erreur serveur");
                }
                return response.text(); // ✅ Récupérer du HTML, pas du JSON
            })
            .then(html => {
                let modalBody = document.querySelector("#mesCommandesModal .modal-body");
                modalBody.innerHTML = html; // ✅ Insérer le HTML récupéré
                new bootstrap.Modal(document.getElementById("mesCommandesModal")).show();
            })
            .catch(error => console.error("Erreur lors du chargement des commandes :", error));
        });
    }
});
</script>
   {% endblock %}
{% block javascripts2 %}
<!-- ✅ Script AJAX pour charger les commandes -->
 
    <script src="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.6.1/nouislider.min.js"></script>
    <script>
        // JavaScript pour le filtrage en temps réel
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('search');
            const categorySelect = document.getElementById('category');
            const minPriceInput = document.getElementById('minPrice');
            const maxPriceInput = document.getElementById('maxPrice');
            const priceSlider = document.getElementById('price-slider');
            const productItems = document.querySelectorAll('.product-item');

            if (priceSlider) {
                noUiSlider.create(priceSlider, {
                    start: [
                        parseFloat(minPriceInput.value) || 0,
                        parseFloat(maxPriceInput.value) || 10000
                    ],
                    connect: true,
                    range: {
                        'min': 0,
                        'max': 10000
                    },
                    tooltips: [true, true],
                    format: {
                        to: function (value) {
                            return Math.round(value);
                        },
                        from: function (value) {
                            return Number(value);
                        }
                    }
                });

                priceSlider.noUiSlider.on('update', function (values, handle) {
                    if (handle === 0) {
                        minPriceInput.value = values[0];
                    } else {
                        maxPriceInput.value = values[1];
                    }
                    filterProducts();
                });
            }

            searchInput.addEventListener('input', filterProducts);
            categorySelect.addEventListener('change', filterProducts);

            function filterProducts() {
                const searchQuery = searchInput.value.trim().toLowerCase();
                const selectedCategory = categorySelect.value;
                const minPrice = parseFloat(minPriceInput.value) || 0;
                const maxPrice = parseFloat(maxPriceInput.value) || Infinity;

                productItems.forEach(product => {
                    const category = product.getAttribute('data-category');
                    const price = parseFloat(product.getAttribute('data-price'));
                    const searchText = product.getAttribute('data-search');

                    const matchesSearch = searchText.includes(searchQuery);
                    const matchesCategory = !selectedCategory || category === selectedCategory;
                    const matchesPrice = price >= minPrice && price <= maxPrice;

                    if (matchesSearch && matchesCategory && matchesPrice) {
                        product.style.display = 'block';
                    } else {
                        product.style.display = 'none';
                    }
                });
            }

            filterProducts();
        });
    </script>
{% endblock %}
{% block javascripts11 %}
<script>
 document.addEventListener("DOMContentLoaded", function () {
        updateCart();
    });
	function toggleCart() {
		var cartDropdown = document.getElementById('cartDropdown');
		cartDropdown.style.display = (cartDropdown.style.display === 'block') ? 'none' : 'block';
	}
	function addToCart(id, libelle, prix) {
		var cart = JSON.parse(localStorage.getItem('cart')) || [];
		var productIndex = cart.findIndex(item => item.id === id);
		if (productIndex !== -1) {
			cart[productIndex].quantity++;
		} else {
			cart.push({ id: id, libelle: libelle, prix: prix, quantity: 1 });
		}
		localStorage.setItem('cart', JSON.stringify(cart));
		updateCart();
	}
	function increaseQuantity(id) {
		var cart = JSON.parse(localStorage.getItem('cart')) || [];
		var product = cart.find(item => item.id === id);
		if (product) {
			product.quantity++;
			localStorage.setItem('cart', JSON.stringify(cart));
			updateCart();
		}
	}
	function decreaseQuantity(id) {
		var cart = JSON.parse(localStorage.getItem('cart')) || [];
		var product = cart.find(item => item.id === id);
		if (product && product.quantity > 1) {
			product.quantity--;
			localStorage.setItem('cart', JSON.stringify(cart));
			updateCart();
		}
	}
	function updateCart() {
    var cartItemsContainer = document.getElementById('cartItems');
    var cartCount = document.getElementById('cartCount');
    var cartTotal = document.getElementById('cartTotal');
    var cart = JSON.parse(localStorage.getItem('cart')) || [];
    cartItemsContainer.innerHTML = '';
    cartTotal.innerHTML = '';
    if (cart.length === 0) {
        cartItemsContainer.innerHTML = '<p>Aucun article dans le panier.</p>';
        cartCount.textContent = '0';
    } else {
        var totalQuantity = 0, totalPrice = 0;
        cart.forEach(item => {
            var cartItem = document.createElement('div');
            cartItem.innerHTML = `<p>${item.libelle} - ${item.quantity} x ${item.prix}€</p>
                <div class="quantity-btn">
                    <button class="tns-quantity-btn" onclick="decreaseQuantity(${item.id})">-</button>
                    <span>${item.quantity}</span>
                    <button class="tns-quantity-btn" onclick="increaseQuantity(${item.id})">+</button>
                </div>`;
            cartItemsContainer.appendChild(cartItem);
            totalQuantity += item.quantity;
            totalPrice += item.quantity * item.prix;
        });
        cartTotal.innerHTML = `<h5>Total: ${totalPrice}€</h5>`;
        cartCount.textContent = totalQuantity;
    }
}
	updateCart();

	function clearCart() {
		localStorage.removeItem('cart');
		updateCart();
	}

function checkout() {
    var cart = JSON.parse(localStorage.getItem('cart')) || [];

    if (cart.length === 0) {
        alert("Votre panier est vide.");
        return;
    }

    // ✅ Sauvegarde du panier côté serveur
    fetch('/panier/sauvegarder', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(cart)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // ✅ Redirection vers la validation (PAS de suppression du panier ici !)
            window.location.href = '/panier/valider'; // Change cette URL si nécessaire
        } else {
            alert("Erreur lors de la sauvegarde du panier.");
        }
    })
    .catch(error => {
        console.error("Erreur lors de l'envoi du panier :", error);
        alert("Une erreur est survenue. Veuillez réessayer.");
    });
}

    fetch('/panier/sauvegarder', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(cart)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            window.location.href = '/panier/valider'; // Rediriger après sauvegarde
        } else {
            alert("Erreur lors de la sauvegarde du panier.");
        }
    });
</script>
{% endblock %}

