{% block title %}Paiement sécurisé
{% endblock %}

{% block body %}
	{{ parent() }}

	<div class="container mt-5">
		<h2 class="mb-4">Finaliser votre paiement</h2>

		<div class="card p-4 shadow-sm">
			<p>
				<strong>Utilisateur :</strong>
				{{ app.user.email }}</p>
			<p>
				<strong>Montant :</strong>
				{{ totalPrice }}
				TND</p>

			<form action="{{ path('checkout') }}" method="POST">
				<input type="hidden" name="email" value="{{ app.user.email }}">
				<input type="hidden" name="totalPrice" value="{{ totalPrice }}">
				<button type="submit" class="btn btn-success btn-lg w-100">Payer maintenant</button>
			</form>
		</div>
	</div>
{% endblock %}
