				{% block body %}
					<h2 style="text-align:center">
						Gestion des activités

					</h2>
					<button style="margin-left:1110px;background-color:#87CEEB;color:white;font-weight:bold" type="button" class="btn btn-icon-split" id="openModalBtn">
						<span class="text">Ajouter une activité</span>
					</button>

					<div class="card-container">
						{% for activite in activites %}
							<div class="card" style="display:flex">
								<div class="card-image">
									<img src="{{ asset('uploads/images/' ~ activite.image) }}" class="activity-image" alt="{{ activite.libelle }}">

								</div>

								<div class="card-body">
									<h5 class="card-title">{{ activite.libelle }}</h5><hr>

									<div style="display:flex">
										<p>
											<i style="color:#53d2dc" class="fas fa-calendar-day"></i>
											<strong>Date début:</strong>
											{{ activite.dateDebut|date('d/m/Y') }}

										</p>
										&nbsp;&nbsp;
										<p>
											<i style="color:#53d2dc" class="fas fa-calendar-day"></i>
											<strong>Date Fin :</strong>
											{{ activite.dateFin|date('d/m/Y') }}
										</p>
									</div>


									<p>
										<strong>Localisation:</strong>
										{{ activite.localisation }}</p>
									<p>
										<strong>Prix:</strong>
										{{ activite.prix }}
										<span style="font-size:12px;font-style:italic">TND/personne</span>
									</p>
									<div style="display:flex">
										<p>
											<i style="color:#53d2dc" class="fas fa-clock"></i>
											<strong>Durée:</strong>
											{{ activite.duree }}
											jours
										</p>
										&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
										<p>
											<i style="color:#53d2dc" class="fas fa-users"></i>
											<strong>Capacité:</strong>
											{{ activite.capacite }}
										</p>
									</div>

									<hr>
									<div style="display: flex; gap: 15px; margin-left:80px">
										<a href="{{ path('app_activite_showBack', {'id': activite.id}) }}" class="icon-link">
											<img src="{{ asset('admin/img/showIcone.png') }}" class="icon" alt="Show"/>
										</a>
										<a href="#" class="edit-btn" data-id="{{ activite.id }}">
											<img src="{{asset('admin/img/editIcone.png')}}"/>
										</a>
										<div class="icon-link">
											{{ include('BackOffice-Activites/_delete_form.html.twig', { 
                                                'button_class': 'icons',
                                                'button_style': 'border: none; background: none; cursor: pointer;',
                                                'button_content': '<img src="' ~ asset('admin/img/deleteIcone.png') ~ '" alt="Delete"/>'
                                            }) }}
										</div>
									</div>

								</div>
							</div>
						{% else %}
							<p>Aucune activité trouvée.</p>
						{% endfor %}
					</div>


				{% endblock %}

				<div class="modal fade" id="addActiviteModal" tabindex="-1" role="dialog" aria-labelledby="addActiviteModalLabel" aria-hidden="true">
					<div class="modal-dialog" role="document">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title" id="addActiviteModalLabel">Ajouter une activité</h5>
								<button type="button" class="close" data-dismiss="modal" aria-label="Close">
									<span aria-hidden="true">&times;</span>
								</button>
							</div>
							<div class="modal-body">
								<div id="form-container"></div>
							</div>
						</div>
					</div>
				</div>

				<div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
					<div class="modal-dialog" role="document">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title" id="exampleModalLabel">Êtes-vous sûr de vouloir quitter ?</h5>
								<button class="close" type="button" data-dismiss="modal" aria-label="Close">
									<span aria-hidden="true">×</span>
								</button>
							</div>
							<div class="modal-body">Cliquez sur "Se déconnecter" pour confirmer.</div>
							<div class="modal-footer">
								<button class="btn btn-secondary" type="button" data-dismiss="modal">Annuler</button>
								<a class="btn btn-primary" style="background-color:#53d2dc" href="{{ path('app_logout') }}">Se déconnecter</a>

							</div>
						</div>
					</div>
				</div>
				{% block javascripts %}
					<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
					<script>
						$(document).ready(function () {
$('#openModalBtn').on('click', function () {
$('#addActiviteModal').modal('show');
$('#addActiviteModalLabel').text('Ajouter une activité');
$('#form-container').html('');

$.ajax({
url: '{{ path("app_activite_new") }}',
method: 'GET',
success: function (response) {
$('#form-container').html(response);

$('#activite-form').on('submit', function (e) {
e.preventDefault();

var formData = new FormData(this);

$.ajax({
url: '{{ path("app_activite_new") }}',
method: 'POST',
data: formData,
processData: false,
contentType: false,
success: function () {
$('#addActiviteModal').modal('hide');
location.reload();
},
error: function (xhr) {
alert('Erreur lors de l\'ajout');
console.log(xhr.responseText);
}
});
});
},
error: function (xhr) {
console.log(xhr.responseText);
}
});
});

// Ouvrir modal pour éditer une activité
$('.edit-btn').on('click', function () {
var id = $(this).data('id');
$('#addActiviteModal').modal('show');
$('#addActiviteModalLabel').text('Modifier l\'activité');
$('#form-container').html('');

$.ajax({
url: '{{ path("app_activite_edit", {"id": "replace_with_id"}) }}'.replace('replace_with_id', id),
method: 'GET',
success: function (response) {
$('#form-container').html(response);

$('#activite-form').on('submit', function (e) {
e.preventDefault();

var formData = new FormData(this);

$.ajax({
url: '{{ path("app_activite_edit", {"id": "replace_with_id"}) }}'.replace('replace_with_id', id),
method: 'POST',
data: formData,
processData: false,
contentType: false,
success: function () {
$('#addActiviteModal').modal('hide');
location.reload();
},
error: function (xhr) {
alert('Erreur lors de la modification');
console.log(xhr.responseText);
}
});
});
},
error: function (xhr) {
console.log(xhr.responseText);
}
});
});
});
					</script>
