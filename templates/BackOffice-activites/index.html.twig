			.card-description {
				font-size: 14px;
				margin-bottom: 10px;
			}

			.card-actions {
				display: flex;
				justify-content: space-between;
			}

			.btn {
				padding: 8px 12px;
				font-size: 14px;
				border-radius: 5px;

